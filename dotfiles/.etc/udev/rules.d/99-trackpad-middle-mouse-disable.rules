# Disable middle mouse button on Elantech Touchpad whenever it's detected
# This ensures the mapping persists through monitor hot-plug/unplug events
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{name}=="ETPS/2 Elantech Touchpad", RUN+="/usr/bin/bash -c 'sleep 0.5 && DISPLAY=:0 /usr/bin/xinput set-button-map $(/usr/bin/xinput list --id-only \"ETPS/2 Elantech Touchpad\") 1 1 3 4 5 6 7'"
