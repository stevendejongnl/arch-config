.idea

*.code-workspace

.dwm/slstatus/package-updates/last-run
.dwm/slstatus/package-updates/status
.dwm/statusbar/harvest/.env
.dwm/statusbar/harvest/state
.dwm/statusbar/harvest/last-run
.config/nvim/plugin/packer_compiled.lua
.config/nvim/pack
.config/tmux/plugins
.config/gtk-3.0/bookmarks

# Alacritty backup files (created during config migration)
.config/alacritty/*.bak

# Systemd enable symlinks (managed by systemctl/dotfiles-systemd.sh)
.config/systemd/user/*.target.wants/

# Auto-generated desktop files and MIME cache
.local/share/applications/*.desktop
.local/share/applications/mimeinfo.cache

.zsh-config/spaceship.zsh.zwc

.openvpn3/autoload
nohup.out

# runtime cache (churns constantly)
.dwm/statusbar/package-updates/status

# rime theme installer: per-run backups + generated Chrome theme extension
*.rime-backup-*
.local/share/rime-chrome-theme/
