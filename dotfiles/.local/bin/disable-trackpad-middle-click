#!/usr/bin/env bash
# Script to disable middle mouse button on Elantech Touchpad
# Called by udev or systemd to reapply button mapping after device hotplug

set -e

# Wait for X11 to be ready (useful after display changes)
sleep 1

# Get the first available X display
DISPLAY=$(ps -C Xvfb,X -f --no-header | sed -n 's/.*\(:[0-9]\+\).*/\1/p' | head -1)
if [ -z "$DISPLAY" ]; then
    DISPLAY=:0
fi

export DISPLAY
export XAUTHORITY="$HOME/.Xauthority"

# Get the touchpad device ID
DEVICE_ID=$(/usr/bin/xinput list --id-only 'ETPS/2 Elantech Touchpad' 2>/dev/null) || exit 1

# Apply button mapping: disable middle click by mapping button 2 to button 1
/usr/bin/xinput set-button-map "$DEVICE_ID" 1 1 3 4 5 6 7

echo "✓ Disabled middle mouse button on Elantech Touchpad (device $DEVICE_ID)"
