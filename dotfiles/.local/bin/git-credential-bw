#!/usr/bin/env bash
# git credential helper for git.madebysteven.nl, from Bitwarden.
# Enable with: git config --global --add credential.helper bw
# Username: the login of the Bitwarden item "gitea". Password: the field gitea-token
# of the item "auth-tokens". Needs bw-session, so a locked vault shows an unlock popup.
set -u
[ "${1:-}" = get ] || exit 0

host=
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  [ "$key" = host ] && host=$value
done
[ "$host" = git.madebysteven.nl ] || exit 0

export BW_SESSION
BW_SESSION=$(bw-session "git login for $host") || exit 1
user=$(bw get username gitea) || exit 1
token=$(bw get item auth-tokens | jq -er '.fields[] | select(.name == "gitea-token") | .value') || exit 1
printf 'username=%s\npassword=%s\n' "$user" "$token"
