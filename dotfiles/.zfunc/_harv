(( $+functions[_harv_commands] )) ||
_harv_commands() {
    local commands; commands=(
'sync:Check git commits and sync to Harvest (default command)' \
'status:Show current Harvest timer status' \
'stop:Stop the currently running Harvest timer' \
'add:Manually add a time entry with interactive prompts' \
'continue:Continue work on an existing time entry by starting a new timer' \
'generate:Generate time entries from a work summary using AI' \
'config:Configuration management' \
'completions:Generate shell completions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'harv commands' commands "$@"
}
