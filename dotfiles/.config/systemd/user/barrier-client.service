[Unit]
Description=Barrier (keyboard/mouse sharing client)
After=graphical-session.target network-online.target
Wants=network-online.target
# No OnFailure notify here: the workstation is dual-boot and routinely
# sits in Windows with no barrier server running, which makes port-probe
# failure a normal, expected, and frequent state (retried every RestartSec)
# rather than something worth paging for. Restart=always keeps retrying
# silently; check `systemctl --user status barrier-client` manually if needed.
# Only autostart on the client machine — arch-workstation runs the
# server side, managed separately (see barrier.service).
ConditionHost=computersloeber

[Service]
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do xdpyinfo -display :0 >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
# Server (StreamPC / arch-workstation) address: 192.168.1.130.
# Off the home LAN (e.g. at work), the IP is simply unreachable -- ping
# fails even if the client's own subnet coincidentally looks the same
# (192.168.1.x at work too). Treat that as "not home", exit 0 (no restart
# spam, no OnFailure); only exit 1 -- a real failure -- when the host itself
# answers ping (on-LAN, powered on) but the barrier port doesn't.
# Note: intentionally NOT using `ip neigh` -- ARP cache entries go STALE
# rather than disappearing when a host is powered off, which falsely
# counted as "on LAN" and fired spurious OnFailure alerts while the
# workstation was simply off.
ExecStart=/bin/bash -c '\
  ip=192.168.1.130; \
  ping -c1 -W1 "$ip" >/dev/null 2>&1 || exit 0; \
  nc -z -w1 "$ip" 24800 && exec barrierc -f --no-tray --no-restart --name computersloeber --disable-crypto "$ip:24800"; \
  exit 1'
TimeoutStartSec=45
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# on-failure alone won't retry the off-LAN case (that now exits 0, clean);
# Restart=always keeps re-probing so it connects as soon as we're back on
# the LAN, without spamming — off-LAN loops silently since exit 0 skips
# OnFailure entirely.
Restart=always
RestartSec=15

[Install]
WantedBy=autostart.target
