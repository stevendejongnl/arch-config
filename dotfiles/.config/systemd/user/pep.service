[Unit]
Description=Pep - Keep System Awake Tool 💊
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do xdpyinfo -display :0 >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
ExecStart=/home/stevendejong/.local/bin/pep
TimeoutStartSec=30
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
