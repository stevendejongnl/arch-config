[Unit]
Description=Network Manager Applet
After=graphical-session.target
OnFailure=autostart-failure@%n.service

[Service]
ExecStartPre=/bin/bash -c 'for i in $(seq 60); do xdpyinfo -display :0 >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
ExecStart=nm-applet
TimeoutStartSec=45
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Restart=on-failure
RestartSec=3

[Install]
WantedBy=autostart.target
