[Unit]
Description=Clipman
After=graphical-session.target
OnFailure=autostart-failure@%n.service
# Only present on hosts with the computer-sloeber module (xfce4-clipman-plugin package).
# Without this, an accidental `systemctl --user enable` on any other host restart-loops forever.
ConditionPathExists=/usr/bin/xfce4-clipman

[Service]
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do xdpyinfo -display :0 >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
ExecStart=xfce4-clipman
TimeoutStartSec=30
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Restart=on-failure
RestartSec=3

[Install]
WantedBy=autostart.target
