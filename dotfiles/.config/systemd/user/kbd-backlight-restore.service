[Unit]
Description=Restore keyboard backlight after suspend
# Note: This service can be started manually with:
# systemctl --user start kbd-backlight-restore.service
# For automatic restoration on suspend/resume, use the system sleep hook at:
# /usr/lib/systemd/system-sleep/kbd-backlight-restore

[Service]
Type=oneshot
ExecStart=/bin/bash /home/stevendejong/.config/systemd/user/scripts/kbd-backlight-restore.sh
