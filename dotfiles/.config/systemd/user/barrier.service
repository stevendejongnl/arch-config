[Unit]
Description=Barrier (keyboard/mouse sharing server)
After=graphical-session.target
OnFailure=autostart-failure@%n.service
# Only autostart on the host machine — computersloeber (laptop) runs as
# client with its own separate setup, not managed here.
ConditionHost=arch-workstation

[Service]
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do xdpyinfo -display :0 >/dev/null 2>&1 && exit 0; sleep 0.5; done; exit 1'
ExecStart=barrier
TimeoutStartSec=30
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Restart=on-failure
RestartSec=3

[Install]
WantedBy=autostart.target
