/* Flat theme: light ink on near-black, the selected row is a light fill.
 * Used by the app launcher (Mod+Space), the window switcher (Mod+Alt+Space) and rofi-rbw.
 * The colours match the dwm bar, the bar popup and the dunst notifications. */

configuration {
    modes:                  "drun,window,run";
    show-icons:             true;
    icon-theme:             "Papirus";
    disable-history:        false;
    drun-display-format:    "{name}";
    window-format:          "{c}  ·  {t}";
    display-drun:           "󰀻";
    display-window:         "󰖯";
    display-run:            "";
    display-ssh:            "󰣀";
}

* {
    font:                   "Inter Tight 12";

    bg:                     #1c1d1f;
    bar:                    #17181a;
    line:                   #2b2d31;
    line-hi:                #3d3f44;
    hover:                  #34363a;
    fg:                     #ecebe6;
    sec:                    #a8a9ad;
    dim:                    #8b8c91;
    yellow:                 #f2c46d;
    red:                    #f08f87;

    background-color:       transparent;
    text-color:             @fg;
    margin:                 0;
    padding:                0;
    spacing:                0;
}

window {
    location:               center;
    anchor:                 center;
    y-offset:               -80px;
    width:                  620px;
    background-color:       @bg;
    border:                 1px;
    border-color:           @line-hi;
    border-radius:          6px;
}

mainbox {
    padding:                0;
    spacing:                0;
    children:               [ inputbar, message, listview ];
}

inputbar {
    padding:                0 16px;
    spacing:                12px;
    height:                 48px;
    background-color:       transparent;
    border:                 0 0 1px 0;
    border-color:           @line;
    children:               [ prompt, entry ];
}

prompt {
    text-color:             @dim;
    font:                   "JetBrainsMono Nerd Font 12";
    vertical-align:         0.5;
}

entry {
    text-color:             @fg;
    placeholder:            "Search";
    placeholder-color:      @dim;
    cursor-color:           @fg;
    vertical-align:         0.5;
}

message {
    border:                 0 0 1px 0;
    border-color:           @line;
    padding:                10px 16px;
    background-color:       transparent;
}

textbox {
    text-color:             @sec;
}

listview {
    border:                 0px;
    lines:                  8;
    columns:                1;
    fixed-height:           false;
    scrollbar:              false;
    spacing:                0;
    dynamic:                true;
}

element {
    padding:                0 16px;
    spacing:                14px;
    height:                 40px;
    border-radius:          0;
}

element-icon {
    size:                   22px;
    vertical-align:         0.5;
}

element-text {
    vertical-align:         0.5;
    highlight:              bold underline;
}

element normal.normal, element alternate.normal {
    background-color:       transparent;
    text-color:             @fg;
}

element selected.normal {
    background-color:       @fg;
    text-color:             #1c1d1f;
}

element normal.urgent, element alternate.urgent {
    background-color:       transparent;
    text-color:             @red;
}

element selected.urgent {
    background-color:       @red;
    text-color:             #1c1d1f;
}

element normal.active, element alternate.active {
    background-color:       transparent;
    text-color:             @yellow;
}

element selected.active {
    background-color:       @fg;
    text-color:             #1c1d1f;
}
