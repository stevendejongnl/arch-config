/* Rime theme — https://git.madebysteven.nl/stevendejong/rime
 * Used by the app launcher (Mod+Space), the window switcher (Mod+Alt+Space) and rofi-rbw.
 * The colours match the dwm status bar popup and the dunst notifications. */

configuration {
    modes:                  "drun,window,run";
    show-icons:             true;
    icon-theme:             "Papirus";
    disable-history:        false;
    drun-display-format:    "{name}";
    window-format:          "{c}  ·  {t}";
    display-drun:           "󰀻";
    display-window:         "󰖯";
    display-run:            "";
    display-ssh:            "󰣀";
}

* {
    font:                   "JetBrainsMono Nerd Font 12";

    bg:                     #12141cf2;
    card:                   #181b26;
    line:                   #2a2f3d;
    fg:                     #d3d6e6;
    dim:                    #7a7f99;
    accent:                 #3ee6e0;
    yellow:                 #ffd473;
    red:                    #ff5c78;

    background-color:       transparent;
    text-color:             @fg;
    margin:                 0;
    padding:                0;
    spacing:                0;
}

window {
    location:               center;
    anchor:                 center;
    y-offset:               -80px;
    width:                  660px;
    background-color:       @bg;
    border:                 1px;
    border-color:           @line;
    border-radius:          16px;
}

mainbox {
    padding:                16px;
    spacing:                14px;
    children:               [ inputbar, message, listview ];
}

inputbar {
    padding:                12px 16px;
    spacing:                12px;
    background-color:       @card;
    border:                 1px;
    border-color:           @line;
    border-radius:          12px;
    children:               [ prompt, entry ];
}

prompt {
    text-color:             @accent;
    font:                   "JetBrainsMono Nerd Font 14";
}

entry {
    text-color:             @fg;
    placeholder:            "Search";
    placeholder-color:      @dim;
    cursor-color:           @accent;
}

message {
    border:                 0px;
    padding:                10px 14px;
    background-color:       @card;
    border-radius:          10px;
}

textbox {
    text-color:             @dim;
}

listview {
    border:                 0px;
    lines:                  8;
    columns:                1;
    fixed-height:           false;
    scrollbar:              false;
    spacing:                4px;
    dynamic:                true;
}

element {
    padding:                9px 12px;
    spacing:                14px;
    border-radius:          10px;
}

element-icon {
    size:                   28px;
    vertical-align:         0.5;
}

element-text {
    vertical-align:         0.5;
    highlight:              bold #3ee6e0;
}

element normal.normal, element alternate.normal {
    background-color:       transparent;
    text-color:             @fg;
}

element selected.normal {
    background-color:       @line;
    text-color:             #ffffff;
}

element normal.urgent, element alternate.urgent {
    background-color:       transparent;
    text-color:             @red;
}

element selected.urgent {
    background-color:       @red;
    text-color:             #12141c;
}

element normal.active, element alternate.active {
    background-color:       transparent;
    text-color:             @yellow;
}

element selected.active {
    background-color:       @line;
    text-color:             @yellow;
}
