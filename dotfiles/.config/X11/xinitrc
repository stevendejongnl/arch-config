xrdb $HOME/.config/X11/xresources

export _JAVA_AWT_WM_NONREPARENTING=1

dbus-update-activation-environment --systemd DBUS_SESSION_BUS_ADDRESS DISPLAY XAUTHORITY

systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS
systemctl --user start xsession.service

pgrep -x numlockx > /dev/null || numlockx &
pgrep -x picom > /dev/null || picom &
#pgrep -x ntfd > /dev/null || ntfd &
pgrep -x lxpolkit > /dev/null || lxpolkit &
pgrep -f "update-statusbar.sh" > /dev/null || (
  for i in {1..50}; do
    pgrep -x upower > /dev/null && break
    sleep 0.1
  done
  /home/stevendejong/.dwm/update-statusbar.sh
) &
command -v batify > /dev/null && { pgrep -x batify > /dev/null || batify & }
#pgrep -x deja-dup > /dev/null || deja-dup &

xsetroot -cursor_name left_ptr

#xset +fp $HOME/.local/share/fonts
#xset +fp /usr/share/fonts &
xset fp rehash &

# No X-level screen blanking / DPMS. Idle-suspend is handled separately by pep
# (systemd-inhibit); pep does NOT stop the X server blanking the screen.
xset s off
xset s noblank
xset -dpms

# Hide cursor after x time
unclutter -idle 3 &

# Remap caps lock to escape
setxkbmap -option caps:escape

# Disable middle mouse button on Elantech Touchpad
$HOME/.local/bin/disable-trackpad-middle-click &

gsettings set org.gnome.desktop.interface color-scheme prefer-dark &  # locked dark (modules/dark-mode.yaml)
#brightnessctl --device='amdgpu_bl1' set 255 &
brightnessctl --device='tpacpi::kbd_backlight' set 2 &


mkdir -p "$HOME/.logs"
while true; do
  dwm > "$HOME/.logs/dwm.log" 2>&1
done

# Clean up autostart services when X session ends
systemctl --user stop xsession.service
